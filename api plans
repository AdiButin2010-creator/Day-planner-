// Серверная функция Vercel: считает калории и составляет расписание дня.
// Использует переменные окружения:
//   PLAN_API_KEY — секретный ключ сервиса (без него расчёт не работает)
//   APP_NAME     — название сайта, которое показывается в шапке
// Ключ хранится только на сервере и никогда не отправляется в браузер.

const pad = (n) => String(n).padStart(2, '0');
const toMin = (t) => {
  const m = /^(\d{1,2}):(\d{2})$/.exec(String(t || '').trim());
  if (!m) return null;
  const h = Number(m[1]), mi = Number(m[2]);
  if (h > 23 || mi > 59) return null;
  return h * 60 + mi;
};
const fmt = (min) => {
  const m = ((Math.round(min) % 1440) + 1440) % 1440;
  return `${pad(Math.floor(m / 60))}:${pad(m % 60)}`;
};
const round5 = (x) => Math.round(x / 5) * 5;

const MEALS = {
  3: { names: ['Завтрак', 'Обед', 'Ужин'], w: [0.3, 0.4, 0.3] },
  4: { names: ['Завтрак', 'Обед', 'Полдник', 'Ужин'], w: [0.25, 0.35, 0.15, 0.25] },
  5: { names: ['Завтрак', 'Второй завтрак', 'Обед', 'Полдник', 'Ужин'], w: [0.25, 0.1, 0.3, 0.1, 0.25] },
};
const MEAL_IDEAS = {
  'Завтрак': 'Овсянка или яйца, цельнозерновой хлеб, фрукт',
  'Второй завтрак': 'Йогурт или творог, горсть орехов',
  'Обед': 'Гарнир (рис, гречка, паста) + курица, мясо или рыба + овощи',
  'Полдник': 'Бутерброд с сыром, фрукт или кефир',
  'Ужин': 'Белок (курица, рыба, яйца, творог) + овощи + немного гарнира',
};
const ACTIVITY = { low: 1.2, light: 1.375, mid: 1.55, high: 1.725, extreme: 1.9 };

function buildPlan(input) {
  const errors = [];
  const sex = input.sex === 'f' ? 'f' : 'm';
  const age = Number(input.age), weight = Number(input.weight), height = Number(input.height);
  if (!(age >= 10 && age <= 100)) errors.push('Возраст: от 10 до 100 лет');
  if (!(weight >= 30 && weight <= 250)) errors.push('Вес: от 30 до 250 кг');
  if (!(height >= 120 && height <= 230)) errors.push('Рост: от 120 до 230 см');
  const factor = ACTIVITY[input.activity] || ACTIVITY.mid;
  let goal = ['maintain', 'gain', 'loss'].includes(input.goal) ? input.goal : 'maintain';
  const mealsCount = [3, 4, 5].includes(Number(input.meals)) ? Number(input.meals) : 4;

  const wake = toMin(input.wake);
  let sleep = toMin(input.sleep);
  if (wake === null || sleep === null) errors.push('Укажи время подъёма и отбоя');
  if (errors.length) return { errors };
  if (sleep <= wake) sleep += 1440;
  const inDay = (t) => {
    let m = toMin(t);
    if (m === null) return null;
    if (m < wake) m += 1440;
    return m <= sleep ? m : null;
  };

  const notes = [];
  // Калории по формуле Миффлина–Сан Жеора
  const bmr = 10 * weight + 6.25 * height - 5 * age + (sex === 'm' ? 5 : -161);
  const tdee = bmr * factor;
  if (age < 18) {
    if (goal === 'loss') {
      goal = 'maintain';
      notes.push('До 18 лет сайт не считает дефицит калорий: организму нужна энергия на рост. Показана норма для поддержания. Если хочешь изменить вес, лучше обсудить это с врачом.');
    }
    notes.push('Формула рассчитана на взрослых, поэтому для подростков результат — примерный ориентир.');
  }
  const mult = { maintain: 1, gain: 1.1, loss: 0.85 }[goal];
  let calories = Math.round((tdee * mult) / 10) * 10;
  const floor = Math.round(bmr / 10) * 10;
  if (calories < floor) calories = floor;

  const proteinPerKg = { maintain: 1.6, gain: 1.8, loss: 2.0 }[goal];
  const protein = Math.round(weight * proteinPerKg);
  const fat = Math.round((calories * 0.25) / 9);
  const carbs = Math.max(0, Math.round((calories - protein * 4 - fat * 9) / 4));

  const hasTraining = Boolean(input.trainingTime);
  const water = Math.round((weight * 0.035 + (hasTraining ? 0.5 : 0)) * 10) / 10;

  const sleepHours = Math.round(((wake + 1440 - (sleep % 1440)) % 1440) / 6) / 10;
  const needSleep = age < 18 ? 8 : 7;
  if (sleepHours < needSleep) {
    notes.push(`Сна получается ${sleepHours} ч, а нужно минимум ${needSleep}${age < 18 ? '–10' : '–9'} ч. Попробуй ложиться раньше.`);
  }

  // Расписание
  const ev = [];
  const add = (start, end, icon, title, text, type) => ev.push({ start, end, icon, title, text, type });

  add(wake, wake + 10, '[Alarm]', 'Подъём', 'Стакан воды, умыться, проветрить комнату', 'routine');
  add(wake + 10, wake + 20, '[Stretch]', 'Зарядка', '10 минут лёгкой разминки', 'sport');

  const school = { s: inDay(input.schoolStart), e: inDay(input.schoolEnd) };
  const hasSchool = school.s !== null && school.e !== null && school.e > school.s;
  if (hasSchool) add(school.s, school.e, '[School]', 'Учёба / работа', 'Основное время занятий', 'study');

  let train = null;
  if (hasTraining) {
    const ts = inDay(input.trainingTime);
    const dur = Math.min(240, Math.max(15, Number(input.trainingDuration) || 60));
    if (ts === null) notes.push('Время тренировки не попадает между подъёмом и отбоем, поэтому она не добавлена.');
    else {
      train = { s: ts, e: ts + dur };
      add(train.s, train.e, '[Gym]', 'Тренировка', `${dur} мин. Разминка в начале, растяжка в конце`, 'sport');
      add(train.e, train.e + 15, '[Water]', 'Восстановление', 'Вода, растяжка. Белок — в ближайший приём пищи', 'routine');
    }
  }

  const { names, w } = MEALS[mealsCount];
  const first = wake + 30, last = Math.max(first + 60 * (mealsCount - 1), sleep - 180);
  const mealTimes = names.map((_, i) => round5(first + (i * (last - first)) / (mealsCount - 1)));
  names.forEach((name, i) => {
    let t = mealTimes[i];
    // не ставим еду прямо на тренировку — сдвигаем после неё
    if (train && t > train.s - 45 && t < train.e) t = round5(train.e + 20);
    const kcal = Math.round((calories * w[i]) / 10) * 10;
    const p = Math.round(protein * w[i]);
    let text = `${MEAL_IDEAS[name]}. ≈ ${kcal} ккал, белок ≈ ${p} г`;
    if (hasSchool && t >= school.s && t < school.e) text += ' (можно взять с собой)';
    add(t, t + 20, '[Meal]', name, text, 'meal');
    mealTimes[i] = t;
  });

  if (train && !mealTimes.some((t) => t >= train.s - 180 && t <= train.s - 45)) {
    add(train.s - 60, train.s - 50, '[Snack]', 'Перекус перед тренировкой',
      'Банан, йогурт или бутерброд, ≈150–200 ккал из дневной нормы', 'meal');
  }

  let hw = hasSchool ? school.e + 60 : wake + 90;
  if (train && hw < train.e && hw + 90 > train.s) hw = train.e + 45;
  if (hw + 90 <= sleep - 90) {
    add(hw, hw + 90, '[Study]', hasSchool ? 'Домашнее задание' : 'Главные дела дня',
      'Работай блоками по 25–45 минут с короткими перерывами', 'study');
  }

  const freeS = sleep - 150;
  if (!train || train.e <= freeS) {
    add(freeS, sleep - 60, '[Free]', 'Свободное время', 'Прогулка, друзья, хобби', 'free');
  }
  add(sleep - 60, sleep, '[NoPhone]', 'Подготовка ко сну', 'Без экранов, душ, собрать вещи на завтра', 'routine');
  add(sleep, sleep, '[Sleep]', 'Сон', `${sleepHours} ч сна`, 'sleep');

  ev.sort((a, b) => a.start - b.start);
  const schedule = ev.map((e) => ({
    time: e.end > e.start ? `${fmt(e.start)}–${fmt(e.end)}` : fmt(e.start),
    icon: e.icon, title: e.title, text: e.text, type: e.type,
  }));

  return {
    summary: { calories, bmr: Math.round(bmr), tdee: Math.round(tdee), protein, fat, carbs, water, sleepHours, goal },
    notes,
    schedule,
  };
}

module.exports = (req, res) => {
  const apiKey = process.env.PLAN_API_KEY;
  const appName = process.env.APP_NAME || 'Калькулятор калорий';

  if (req.method === 'GET') {
    return res.status(200).json({ appName, keyConfigured: Boolean(apiKey) });
  }
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Метод не поддерживается' });
  }
  if (!apiKey) {
    return res.status(500).json({
      error: 'На сервере не настроена переменная PLAN_API_KEY. Добавь её в Vercel → Settings → Environment Variables и сделай Redeploy.',
    });
  }

  let body = req.body;
  if (typeof body === 'string') {
    try { body = JSON.parse(body); } catch { body = {}; }
  }
  const result = buildPlan(body || {});
  if (result.errors) return res.status(400).json({ error: result.errors.join('. ') });
  return res.status(200).json({ appName, ...result });
};

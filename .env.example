# Скопируй этот файл в .env и заполни своими значениями.
# Сам .env НЕ загружается в GitHub (он в .gitignore).

# Любой секретный "ключ" — просто для того, чтобы показать, что сайт
# использует переменные окружения. Можешь придумать любую строку.
PLAN_API_KEY=my-secret-key-12345

# Название сайта, которое покажется в шапке страницы
APP_NAME=Калькулятор калорий
